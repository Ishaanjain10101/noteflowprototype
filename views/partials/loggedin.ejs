<script>
    
    
    switch(window.location.pathname){
        case "/":
            document.querySelector("#home").style.backgroundColor = "#c9c6f8";
            break;
        case "/add":
            document.querySelector("#add").style.backgroundColor = "#c9c6f8";
            break;
        case "/fav":
            document.querySelector("#fav").style.backgroundColor = "#c9c6f8";
