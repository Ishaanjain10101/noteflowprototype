<div class="container-sidebar">
    <div class="logo">
        <i class="fa-solid fa-feather-pointed"></i>
        <span>NoteFlow</span>
    </div>
    <a href="/" class="option">
        <div id="home">
            <i class="fa-regular fa-note-sticky"></i>
            <div>All Notes</div>
        </div>
    </a>
    <a href="/add" class="option">
        <div id="add">
            <i class="fa-solid fa-plus"></i>
            <div>Add Note</div>
        </div>
    </a>
    <a href="/fav" class="option">
        <div id="fav">
            <i class="fa-regular fa-star"></i>
            <div>Favourites</div>
        </div>
    </a>
    <a href="/pinned" class="option">
        <div id="pinned">
            <i class="fa-solid fa-thumbtack"></i>
            <div>Pinned</div>
        </div>
    </a>
    <a href="/trash" class="option">
        <div id="trash">
            <i class="fa-solid fa-trash-can"></i>
            <div>Trash</div>
        </div>
    </a>
    <a href="/profile" class="option">
        <div id="profile-link">
            <i class="fa-regular fa-user"></i>
            <div>Profile</div>
        </div>
    </a>
    <a href="/settings" class="option">
        <div id="settings-link">
            <i class="fa-solid fa-gear"></i>
            <div>Settings</div>
        </div>
    </a>
    <div class="sidebar-footer">
        <div class="tagline">Capture ideas. Organise thoughts. Flow effortlessly.</div>
    </div>
</div>

<script>
    switch (window.location.pathname) {
        case "/":
            document.querySelector("#home").classList.add("active");
            break;
        case "/add":
            document.querySelector("#add").classList.add("active");
            break;
        case "/fav":
            document.querySelector("#fav").classList.add("active");
            break;
        case "/pinned":
            document.querySelector("#pinned").classList.add("active");
            break;
        case "/trash":
            document.querySelector("#trash").classList.add("active");
            break;
        case "/profile":
            document.querySelector("#profile-link").classList.add("active");
            break;
        case "/settings":
            document.querySelector("#settings-link").classList.add("active");
            break;
    }
</script>
