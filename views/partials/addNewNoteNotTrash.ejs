<div id="container-maincontent">
    <div id="header">
        <div id="heading">
            <%-title%>
        </div>
    </div>
    <div id="option-selection-grid-list" data-select="true">
        <button id="grid-button" data-select="true">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 50px;">
                    <rect x="3" y="3" width="8" height="8" rx="2"/>
                    <rect x="13" y="3" width="8" height="8" rx="2"/>
                    <rect x="3" y="13" width="8" height="8" rx="2"/>
                    <rect x="13" y="13" width="8" height="8" rx="2"/>
                </svg>
            </div>
        </button>
        <button id="list-button" data-select="false">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 50px;">
                    <rect x="3" y="4" width="4" height="4" rx="1"/>
                    <line x1="11" y1="6" x2="21" y2="6"/>
                    <rect x="3" y="10" width="4" height="4" rx="1"/>
                    <line x1="11" y1="12" x2="21" y2="12"/>
                    <rect x="3" y="16" width="4" height="4" rx="1"/>
                    <line x1="11" y1="18" x2="21" y2="18"/>
                </svg>
            </div>
        </button>
    </div>
    <div style="width: 100%; height:100px;"></div>
    <div id="form" style="position: relative;" data-form="grid">
        <%if(notes.length === 0){%>
            <img src="/images/noNotes2.png" alt="No notes" style="height:67vh;position: absolute;right: 400px;">
        <%}%>
        <%notes.forEach((note,i)=>{%>
            <%if(note.pinned){%>
                <div class="Note" id="note-<%=i+1%>" data-form="grid" >
                    <div class="title-note" id="title-note-<%=i+1%>"></div> 
                    <div class="content-note" id="content-note-<%=i+1%>"></div>
                    <div id="createdAt-note">
                        <%= note.createdAt.toLocaleString("en-IN",{
                            day:"numeric",
                            month:"short",
                            year:"numeric"
                        }) %>
                    </div>  
                    <a href="/note/<%=note._id%>">
                        <div id="view-more">
                            View More
                        </div>
                    </a>      
                    <div class="star">
                        <svg class="outside-element" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" id="star-<%=i+1%>" fill="none" stroke="blue" stroke-width="1.5" stroke-linejoin="round" data-id="<%=note._id%>">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                    </div>
                    <div class="pin-div" >
                        <svg xmlns="http://www.w3.org/2000/svg" class="pin-button" viewBox="0 0 24 24" width="30" height="30" id="pin-<%=i+1%>" stroke="black" stroke-width="1.5" fill="none" stroke-linejoin="round" data-id="<%=note._id%>">
                            <path d="M16 3l5 5-1.42 1.42-1.13-.35-3.44 3.44.71 2.83-1.42 1.42-3.54-3.54-4.6 4.6-1.42-1.42 4.6-4.6-3.54-3.54 1.42-1.42 2.83.71 3.44-3.44-.35-1.13z"/>
                        </svg>
                    </div>
                    
                    <div class="dustbin dustbin-icon" data-id="<%=note._id%>" id="trash-<%=note._id%>">
                        <i class="fa-solid fa-trash-can" ></i>
                    </div>
                </div>
                <dialog id="<%-note._id%>" class="confirmdialog">
                    <div>Are you sure you want to delete this note?</div>
                    <button id="yes">Yes</button>
                    <button id="no">No</button>
                </dialog>
            <%}%>
        <%})%>
        <%notes.forEach((note,i)=>{%>
            <%if(!note.pinned){%>
                <div class="Note" id="note-<%=i+1%>" data-form="grid" >
                    <div class="title-note" id="title-note-<%=i+1%>"></div> 
                    <div class="content-note" id="content-note-<%=i+1%>"></div>
                    <div id="createdAt-note">
                        <%= note.createdAt.toLocaleString("en-IN",{
                            day:"numeric",
                            month:"short",
                            year:"numeric"
                        }) %>
                    </div>  
                    <a href="/note/<%=note._id%>">
                        <div id="view-more">
                            View More
                        </div>
                    </a>
                    <div class="star">
                        <svg class="outside-element" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" id="star-<%=i+1%>" fill="none" stroke="blue" stroke-width="1.5" stroke-linejoin="round" data-id="<%=note._id%>">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                    </div>
                    <div class="pin-div" >
                        <svg xmlns="http://www.w3.org/2000/svg" class="pin-button" viewBox="0 0 24 24" width="30" height="30" id="star-<%=i+1%>" stroke="black" fill="none" stroke-width="1.5" stroke-linejoin="round" data-id="<%=note._id%>">
                            <path d="M16 3l5 5-1.42 1.42-1.13-.35-3.44 3.44.71 2.83-1.42 1.42-3.54-3.54-4.6 4.6-1.42-1.42 4.6-4.6-3.54-3.54 1.42-1.42 2.83.71 3.44-3.44-.35-1.13z"/>
                        </svg>
                    </div>
                    <div class="dustbin dustbin-icon" data-id="<%=note._id%>" id="trash-<%=note._id%>">
                        <i class="fa-solid fa-trash-can" ></i>
                    </div>
                </div>
                <dialog id="<%-note._id%>" class="confirmdialog">
                    <div>Are you sure you want to delete this note?</div>
                    <button id="yes">Yes</button>
                    <button id="no">No</button>
                </dialog>
            <%}%>
        <%})%>
    </div>
</div>
<script>
    if(!(window.location.pathname === "/" || window.location.pathname === "/pinned")){
        document.querySelectorAll(".pin-div").forEach((div)=>{
            div.style.display = "none";
        })
        
    }
    if(window.location.pathname === "/pinned"){
        document.querySelectorAll(".pin-button").forEach((div)=>{
            div.style.right = "10px";
        })           
    }
    if(!(window.location.pathname === "/" || window.location.pathname === "/fav")){
        document.querySelectorAll(".star").forEach((div)=>{
            div.style.display = "none";
        })
    }
    const notesObject = <%- JSON.stringify(notes) %>;
</script>