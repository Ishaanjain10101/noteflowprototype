<div id="container-maincontent">
    <div id="header" class="dashboard-header">
        <div class="dashboard-heading-block">
            <div class="workspace-kicker"><span></span> YOUR NOTEBOOK</div>
            <div class="dashboard-title-row">
                <div id="heading"><%= title === "All Notes" ? "Your notes" : title %></div>
                <span class="note-count"><%= notes.length %> <%= notes.length === 1 ? "note" : "notes" %></span>
            </div>
        </div>
        <a class="dashboard-new-note" href="/add"><i class="fa-solid fa-plus" aria-hidden="true"></i> New note</a>
        <div id="underline"></div>
    </div>

    <div class="dashboard-toolbar">
        <label class="note-search" for="note-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" id="note-search" inputmode="search" autocomplete="off" placeholder="Find a thought..." aria-label="Search notes by title or content">
        </label>
        <div id="option-selection-grid-list" data-select="true"<%= notes.length === 0 ? ' class="empty-view-controls"' : "" %>>
        <button id="grid-button" data-select="true" aria-label="Grid view" title="Grid view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="8" height="8" rx="2"/>
                <rect x="13" y="3" width="8" height="8" rx="2"/>
                <rect x="3" y="13" width="8" height="8" rx="2"/>
                <rect x="13" y="13" width="8" height="8" rx="2"/>
            </svg>
        </button>
        <button id="list-button" data-select="false" aria-label="Row view" title="Row view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="4" height="4" rx="1"/>
                <line x1="11" y1="6" x2="21" y2="6"/>
                <rect x="3" y="10" width="4" height="4" rx="1"/>
                <line x1="11" y1="12" x2="21" y2="12"/>
                <rect x="3" y="16" width="4" height="4" rx="1"/>
                <line x1="11" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
    </div>

    </div>

    <div id="form" data-form="grid" class="<%= notes.length === 0 ? 'empty-form' : '' %>">
        <%if(notes.length === 0){%>
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-regular fa-note-sticky"></i></div>
                <div class="empty-title">No notes yet</div>
                <div class="empty-text">Click "Add Note" to create your first note.</div>
            </div>
        <%}%>

        <%notes.forEach((note,i)=>{%>
            <%if(note.pinned){%>
                <div class="Note" id="note-<%=i+1%>" data-form="grid" data-search-text="<%= [note.title, note.content].join(' ') %>">
                    <div class="title-note" id="title-note-<%=i+1%>"></div>
                    <div class="content-note" id="content-note-<%=i+1%>"></div>
                    <div id="createdAt-note">
                        <%= note.createdAt.toLocaleString("en-IN",{day:"numeric",month:"short",year:"numeric"}) %>
                    </div>
                    <div class="note-actions">
                        <a class="note-view-more" href="/note/<%=note._id%>">Open note <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                        <div class="star">
                            <svg class="outside-element" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" id="star-<%=i+1%>" fill="none" stroke="var(--primary-600)" stroke-width="1.5" stroke-linejoin="round" data-id="<%=note._id%>">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                        </div>
                        <div class="pin-div">
                            <svg xmlns="http://www.w3.org/2000/svg" class="pin-button" viewBox="0 0 24 24" width="30" height="30" id="pin-<%=i+1%>" stroke="var(--neutral-700)" stroke-width="1.5" fill="none" stroke-linejoin="round" data-id="<%=note._id%>">
                                <path d="M16 3l5 5-1.42 1.42-1.13-.35-3.44 3.44.71 2.83-1.42 1.42-3.54-3.54-4.6 4.6-1.42-1.42 4.6-4.6-3.54-3.54 1.42-1.42 2.83.71 3.44-3.44-.35-1.13z"/>
                            </svg>
                        </div>
                        <button type="button" class="dustbin dustbin-icon" data-id="<%=note._id%>" id="trash-<%=note._id%>" aria-label="Move note to trash" title="Move to trash">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <dialog id="<%-note._id%>" class="confirmdialog">
                    <div>Are you sure you want to delete this note?</div>
                    <button id="yes">Yes</button>
                    <button id="no">No</button>
                </dialog>
            <%}%>
        <%})%>

        <%notes.forEach((note,i)=>{%>
            <%if(!note.pinned){%>
                <div class="Note" id="note-<%=i+1%>" data-form="grid" data-search-text="<%= [note.title, note.content].join(' ') %>">
                    <div class="title-note" id="title-note-<%=i+1%>"></div>
                    <div class="content-note" id="content-note-<%=i+1%>"></div>
                    <div id="createdAt-note">
                        <%= note.createdAt.toLocaleString("en-IN",{day:"numeric",month:"short",year:"numeric"}) %>
                    </div>
                    <div class="note-actions">
                        <a class="note-view-more" href="/note/<%=note._id%>">Open note <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                        <div class="star">
                            <svg class="outside-element" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" id="star-<%=i+1%>" fill="none" stroke="var(--primary-600)" stroke-width="1.5" stroke-linejoin="round" data-id="<%=note._id%>">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                        </div>
                        <div class="pin-div">
                            <svg xmlns="http://www.w3.org/2000/svg" class="pin-button" viewBox="0 0 24 24" width="30" height="30" id="pin-<%=i+1%>" stroke="var(--neutral-700)" stroke-width="1.5" fill="none" stroke-linejoin="round" data-id="<%=note._id%>">
                                <path d="M16 3l5 5-1.42 1.42-1.13-.35-3.44 3.44.71 2.83-1.42 1.42-3.54-3.54-4.6 4.6-1.42-1.42 4.6-4.6-3.54-3.54 1.42-1.42 2.83.71 3.44-3.44-.35-1.13z"/>
                            </svg>
                        </div>
                        <button type="button" class="dustbin dustbin-icon" data-id="<%=note._id%>" id="trash-<%=note._id%>" aria-label="Move note to trash" title="Move to trash">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <dialog id="<%-note._id%>" class="confirmdialog">
                    <div>Are you sure you want to delete this note?</div>
                    <button id="yes">Yes</button>
                    <button id="no">No</button>
                </dialog>
            <%}%>
        <%})%>
        <div class="search-empty-state" id="search-empty-state" hidden>
            <span class="empty-icon"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
            <strong>No matching notes</strong>
            <span>Try a different title or phrase.</span>
        </div>
    </div>
</div>

<script>
    if (!(window.location.pathname === "/" || window.location.pathname === "/pinned")) {
        document.querySelectorAll(".pin-div").forEach((div) => { div.style.display = "none"; });
    }
    if (!(window.location.pathname === "/" || window.location.pathname === "/fav")) {
        document.querySelectorAll(".star").forEach((div) => { div.style.display = "none"; });
    }
    const notesObject = <%- JSON.stringify(notes) %>;
    const initialView = window.innerWidth > 950 && localStorage.getItem("viewStyle") === "Row" ? "list" : "grid";
    const notesForm = document.getElementById("form");
    const gridButton = document.getElementById("grid-button");
    const listButton = document.getElementById("list-button");
    notesForm.setAttribute("data-form", initialView);
    gridButton.setAttribute("data-select", initialView === "grid" ? "true" : "false");
    listButton.setAttribute("data-select", initialView === "list" ? "true" : "false");
    document.querySelectorAll(".Note").forEach((note) => note.setAttribute("data-form", initialView));

    const searchInput = document.getElementById("note-search");
    const searchForm = document.getElementById("form");
    const searchEmptyState = document.getElementById("search-empty-state");
    const initialEmptyState = searchForm.querySelector(".empty-state");
    searchInput.addEventListener("input", () => {
        const query = searchInput.value.trim().normalize("NFKC").toLocaleLowerCase();
        const cards = [...searchForm.querySelectorAll(".Note")];
        let visibleCount = 0;
        cards.forEach((card) => {
            const text = (card.dataset.searchText || "").normalize("NFKC").toLocaleLowerCase();
            card.hidden = Boolean(query) && !text.includes(query);
            if (!card.hidden) visibleCount += 1;
        });
        if (initialEmptyState) initialEmptyState.hidden = Boolean(query);
        searchEmptyState.hidden = !query || visibleCount > 0;
    });
</script>
