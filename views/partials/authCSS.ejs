.export-button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:44px; padding:0 16px; border:1px solid #315443; border-radius:10px; background:#315443; color:#fff; font-size:13px; font-weight:650; white-space:nowrap; touch-action:manipulation; }
.export-button:hover { border-color:#29483c; background:#29483c; }
