/* Password recovery uses a compact guided panel, distinct from the split auth screens. */
.recovery-page { min-height:100vh; min-height:100svh; padding:0 28px max(24px, env(safe-area-inset-bottom)); background:radial-gradient(ellipse at 9% 16%, #e7eddf 0, transparent 29%), radial-gradient(ellipse at 92% 89%, #f4e8dc 0, transparent 27%), #f7f6f1; color:#202720; }
.recovery-topbar { width:min(100%, 1120px); min-height:76px; margin:auto; display:flex; align-items:center; justify-content:space-between; }
.recovery-brand { display:inline-flex; align-items:center; gap:10px; color:#293629; font-size:17px; font-weight:700; letter-spacing:-.4px; }
.recovery-brand-mark { width:34px; height:34px; display:grid; place-items:center; border-radius:11px; background:#46583f; color:#fff; }
.recovery-home,.recovery-secure { display:inline-flex; align-items:center; gap:8px; color:#6f766d; font-size:12px; font-weight:600; }
.recovery-home:hover { color:#46583f; }
.recovery-content { width:min(100%, 820px); margin:clamp(20px, 5vh, 58px) auto 0; }
.recovery-progress { display:flex; align-items:center; justify-content:center; gap:13px; margin:0 auto 22px; color:#989b91; }
.recovery-step { display:flex; align-items:center; gap:8px; color:#91958b; font-size:11px; font-weight:650; white-space:nowrap; }
.recovery-step i { width:27px; height:27px; display:grid; place-items:center; border:1px solid #dedfd5; border-radius:50%; background:#f7f6f1; color:#969a8f; font-size:10px; }
.recovery-step.is-current { color:#46583f; }
.recovery-step.is-current i,.recovery-step.is-complete i { border-color:#667f5a; background:#46583f; color:#fff; }
.recovery-step.is-complete { color:#667f5a; }
.recovery-step-line { width:clamp(18px, 5vw, 58px); height:1px; background:#d8dbd0; }
.recovery-step-line.is-complete { background:#829476; }
.recovery-card { display:grid; grid-template-columns:minmax(230px, .78fr) minmax(0, 1fr); min-height:470px; overflow:hidden; border:1px solid #e4e1d8; border-radius:25px; background:#fffefa; box-shadow:0 24px 70px rgba(43,54,40,.09), 0 2px 8px rgba(43,54,40,.04); }
.recovery-art { position:relative; display:grid; place-items:center; min-height:100%; overflow:hidden; background:linear-gradient(145deg,#355d49,#29483c); color:#e1ebaf; }
.recovery-art::before { content:""; position:absolute; inset:0; background:radial-gradient(circle at 50% 47%,rgba(226,235,194,.15),transparent 34%),linear-gradient(150deg,transparent 55%,rgba(17,37,27,.18)); }
.recovery-art-icon { position:relative; z-index:2; width:104px; height:104px; display:grid; place-items:center; border:1px solid rgba(236,242,223,.38); border-radius:30px; background:rgba(245,247,237,.13); box-shadow:0 18px 42px rgba(12,32,22,.18); color:#e6efc4; font-size:36px; transform:rotate(-7deg); }
.recovery-art-orbit { position:absolute; width:280px; height:280px; border:1px solid rgba(236,242,223,.16); border-radius:50%; }
.recovery-art-orbit-one { transform:translate(35px,25px); }
.recovery-art-orbit-two { width:390px; height:390px; transform:translate(35px,25px); }
.recovery-art-spark { position:absolute; z-index:2; color:#e8d99c; }
.recovery-art-spark-one { top:27%; left:24%; font-size:20px; }
.recovery-art-spark-two { right:22%; bottom:27%; font-size:26px; }
.recovery-art-mail { background:linear-gradient(145deg,#4c654f,#334c3d); }
.recovery-art-mail .recovery-art-icon { transform:rotate(4deg); }
.recovery-art-password { background:linear-gradient(145deg,#6a6a4a,#445741); }
.recovery-copy { align-self:center; width:100%; max-width:495px; padding:42px clamp(28px, 5vw, 56px); }
.recovery-kicker { margin-bottom:11px; color:#718464; font-size:10px; font-weight:800; letter-spacing:.13em; }
.recovery-copy h1 { margin:0; color:#202720; font:500 clamp(32px, 4vw, 43px)/1.08 Georgia,'Times New Roman',serif; letter-spacing:-1.35px; }
.recovery-subtitle { margin:12px 0 25px; color:#74766c; font-size:13px; line-height:1.7; }
.recovery-subtitle strong { color:#384636; overflow-wrap:anywhere; }
.recovery-field { margin-bottom:15px; }
.recovery-field label { display:block; margin-bottom:7px; color:#42483f; font-size:12px; font-weight:700; }
.recovery-field input { width:100%; min-height:49px; padding:12px 14px; border:1px solid #e1e2d9; border-radius:11px; background:#fff; color:#202720; font:inherit; font-size:16px; }
.recovery-field input::placeholder { color:#a0a196; }
.recovery-field input:focus { outline:none; border-color:#879c78; box-shadow:0 0 0 3px rgba(108,128,98,.15); }
.recovery-submit { width:100%; min-height:49px; display:flex; align-items:center; justify-content:center; gap:13px; margin-top:8px; padding:0 16px; border:0; border-radius:11px; background:#315443; color:#fff; font-size:13px; font-weight:700; box-shadow:0 9px 20px rgba(49,84,67,.14); cursor:pointer; touch-action:manipulation; }
.recovery-submit:hover { background:#29483c; }
.recovery-submit:disabled { opacity:.62; cursor:wait; }
.recovery-message { min-height:0; margin:0; color:#6d7168; font-size:12px; line-height:1.55; }
.recovery-message:not(:empty) { margin-top:11px; }
.recovery-message.is-error { color:#ae4541; }
.recovery-message.is-success { color:#486b4d; }
