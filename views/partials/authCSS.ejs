.export-button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:44px; padding:0 16px; border:1px solid var(--primary-50); border-radius:10px; background:var(--primary-50); color:#fff; font-size:13px; font-weight:650; white-space:nowrap; touch-action:manipulation; }
