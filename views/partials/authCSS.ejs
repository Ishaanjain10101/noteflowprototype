/* ===== NoteFlow shared account and utility finish ===== */
:root:not([data-theme="dark"]) {
  --primary-50:#edf1e9; --primary-100:#dce5d5; --primary-200:#c1d0b7; --primary-300:#9daf91;
  --primary-400:#819476; --primary-500:#6c8062; --primary-600:#586d50; --primary-700:#46583f; --primary-800:#364632; --primary-900:#293629;
  --accent-50:#fbf0e9; --accent-100:#f4dfd0; --accent-200:#ebc2a7; --accent-300:#dda17c; --accent-400:#ca805a; --accent-500:#b96846;
  --neutral-50:#f7f6f1; --neutral-100:#f0eee7; --neutral-200:#e4e1d8; --neutral-300:#d1cdc2; --neutral-400:#96958a;
  --neutral-500:#74746c; --neutral-600:#5b5d55; --neutral-700:#42463f; --neutral-800:#2c322c; --neutral-900:#202720; --neutral-950:#151b16;
}
:root[data-theme="dark"] {
  --primary-50:#283127; --primary-100:#354332; --primary-200:#4d6148; --primary-300:#6e875f; --primary-400:#8da47d; --primary-500:#a8bb99; --primary-600:#bfd0b3; --primary-700:#d1dec8;
  --accent-50:#38271f; --accent-100:#503629; --accent-200:#81513a; --accent-300:#bd805d; --accent-400:#d79b79; --accent-500:#e2ad8e;
  --neutral-50:#171a17; --neutral-100:#20241f; --neutral-200:#30362f; --neutral-300:#454c44; --neutral-400:#969e91; --neutral-500:#b0b7aa; --neutral-600:#c4cabe; --neutral-700:#d7dcd2; --neutral-800:#e8ebe4; --neutral-900:#f2f3ee; --neutral-950:#fbfcf8;
}
body { background:var(--neutral-50); }
#heading { color:var(--neutral-900); font:500 clamp(26px, 6vw, 32px)/1.15 Georgia, 'Times New Roman', serif; letter-spacing:-.65px; }
.auth-wrapper { min-height:100vh; min-height:100svh; padding:max(22px, env(safe-area-inset-top)) 20px max(22px, env(safe-area-inset-bottom)); background:radial-gradient(ellipse at 13% 15%, var(--primary-50), transparent 37%), radial-gradient(ellipse at 88% 82%, var(--accent-50), transparent 34%), var(--neutral-50); }
.auth-card { max-width:440px; padding:42px 40px; border:1px solid var(--neutral-200); border-radius:22px; background:var(--neutral-0); box-shadow:var(--shadow-lg); }
.auth-logo { margin-bottom:28px; }
.auth-logo a { color:var(--neutral-800); font-size:18px; letter-spacing:-.3px; }
.auth-logo a i { display:grid; place-items:center; width:34px; height:34px; border-radius:11px; background:var(--primary-600); color:#fff; font-size:15px; }
.ball { background:var(--primary-50); }
.ball i { color:var(--primary-700); }
.auth-subtitle { margin:8px 0 28px; color:var(--neutral-500); line-height:1.65; }
.auth-field { margin-bottom:17px; }
.auth-field label { margin-bottom:7px; color:var(--neutral-700); font-size:12px; }
.auth-field input { min-height:49px; padding:12px 14px; border:1px solid var(--neutral-200); border-radius:11px; background:var(--neutral-50); color:var(--neutral-900); font-size:16px; }
.auth-field input:focus { border-color:var(--primary-400); background:var(--neutral-0); box-shadow:0 0 0 3px var(--primary-50); }
#button-login, #button-signup, #button-verify, #button-forgot { min-height:49px; margin-top:8px; border-radius:11px; background:var(--primary-700); color:#fff; touch-action:manipulation; }
#button-login:hover, #button-signup:hover, #button-verify:hover, #button-forgot:hover { background:var(--primary-800); box-shadow:var(--shadow-sm); }
#button-login:disabled, #button-signup:disabled, #button-verify:disabled, #button-forgot:disabled { opacity:.65; cursor:wait; }
#asking { color:var(--neutral-500); }
#asking a { color:var(--primary-700); }
#asking a:hover { color:var(--primary-800); }
.auth-message { min-height:20px; }
#container-code-input { width:100%; max-width:350px; gap:clamp(5px, 2vw, 9px); margin:20px auto 22px; }
.code-input { flex:0 1 min(48px, calc((100vw - 116px) / 6)); min-width:0; height:56px; border:1px solid var(--neutral-200); border-radius:11px; background:var(--neutral-50); color:var(--neutral-900); font-size:22px; caret-color:var(--primary-600); touch-action:manipulation; }
.code-input:focus { border-color:var(--primary-500); background:var(--neutral-0); box-shadow:0 0 0 3px var(--primary-50); outline:none; }
#exhausted { inset:0; margin:auto; width:min(380px, calc(100vw - 32px)); padding:24px; border:1px solid var(--neutral-200); border-radius:18px; background:var(--neutral-0); color:var(--neutral-800); box-shadow:var(--shadow-lg); text-align:center; }
#exhausted::backdrop { background:rgba(25,31,24,.38); }
.settings-section { border-color:var(--neutral-200); border-radius:16px; box-shadow:var(--shadow-xs); }
.settings-section h3 { font:500 19px Georgia, 'Times New Roman', serif; }
