/* ===== Split-screen NoteFlow account experience ===== */
.auth-layout { display:grid; grid-template-columns:minmax(0, .96fr) minmax(0, 1.04fr); min-height:100vh; min-height:100svh; background:var(--neutral-50); }
.auth-story { position:relative; isolation:isolate; display:flex; flex-direction:column; justify-content:space-between; min-width:0; min-height:100vh; min-height:100svh; overflow:hidden; padding:32px clamp(28px, 4.6vw, 72px) 25px; background:#315443; color:#f7f6f1; }
.auth-mobile-brand { display:none; }
.auth-story::before { content:""; position:absolute; z-index:-2; inset:0; background:radial-gradient(ellipse at 18% 8%, rgba(218,231,174,.12), transparent 35%), linear-gradient(145deg, #355d49 0%, #2f5142 56%, #29483c 100%); }
.auth-brand { position:relative; z-index:1; display:inline-flex; align-items:center; align-self:flex-start; gap:10px; color:#f7f6f1; font-size:19px; font-weight:650; letter-spacing:-.45px; }
.auth-brand:hover { color:#e4edbf; }
.auth-brand-mark { width:35px; height:35px; display:grid; place-items:center; border:1px solid rgba(245,247,237,.24); border-radius:11px; background:rgba(245,247,237,.12); color:#e3ecbd; font-size:15px; }
.auth-story-content { position:relative; z-index:1; width:min(100%, 560px); margin:clamp(38px, 7vh, 78px) auto; }
.auth-story-eyebrow { display:flex; align-items:center; gap:9px; margin-bottom:23px; color:#e5ebd7; font-size:10px; font-weight:700; letter-spacing:.12em; line-height:1.5; }
.auth-story-eyebrow span { width:9px; height:9px; flex:0 0 auto; border-radius:50%; background:#b8d5b8; box-shadow:0 0 0 6px rgba(184,213,184,.13); }
.auth-story h2 { margin:0; color:#fff; font:600 clamp(43px, 5.1vw, 72px)/1.04 var(--font-body); letter-spacing:-3.8px; }
.auth-story h2 em { color:#e1ebaf; font-style:normal; }
.auth-story-content > p { max-width:465px; margin:23px 0 0; color:rgba(247,246,241,.82); font-size:15px; line-height:1.85; }
.auth-note-card { width:min(100%, 405px); margin-top:32px; padding:19px 22px 17px; border:1px solid rgba(237,241,226,.26); border-radius:19px; background:rgba(238,242,227,.13); box-shadow:0 18px 40px rgba(20,38,30,.12); }
.auth-note-top { display:flex; align-items:center; justify-content:space-between; }
.auth-note-symbol { width:35px; height:35px; display:grid; place-items:center; border-radius:10px; background:rgba(247,246,241,.17); color:#fff; font-size:15px; }
.auth-note-star { color:#f0d78e; font-size:18px; }
.auth-note-card h3 { margin:20px 0; color:#fff; font-size:22px; font-weight:650; letter-spacing:-.65px; line-height:1.5; }
.auth-note-caption { display:flex; align-items:center; gap:8px; color:rgba(247,246,241,.76); font-size:11px; }
.auth-note-caption i { color:#c2d6b4; }
.auth-story-footer { position:relative; z-index:1; color:rgba(247,246,241,.68); font-size:11px; font-weight:550; }
.auth-orbit { position:absolute; z-index:-1; width:470px; height:470px; border:1px solid rgba(236,242,223,.11); border-radius:50%; pointer-events:none; }
.auth-orbit-one { right:-225px; bottom:-225px; }
.auth-orbit-two { right:-325px; bottom:-325px; width:650px; height:650px; }
.auth-main { position:relative; display:flex; flex-direction:column; min-width:0; min-height:100vh; min-height:100svh; padding:72px clamp(28px, 5.2vw, 80px) 20px; background:var(--neutral-50); }
.auth-back { position:absolute; top:24px; right:clamp(22px, 3.5vw, 52px); display:inline-flex; align-items:center; gap:9px; min-height:40px; color:var(--neutral-500); font-size:12px; font-weight:500; }
.auth-back i { color:var(--primary-500); }
.auth-back:hover { color:var(--primary-700); }
.auth-main .auth-card { width:min(100%, 450px); max-width:450px; margin:auto; padding:18px 0 22px; border:0; border-radius:0; background:transparent; box-shadow:none; }
.auth-form-mark { width:48px; height:48px; display:grid; place-items:center; margin-bottom:25px; border:1px solid var(--primary-100); border-radius:14px; background:var(--primary-50); color:var(--primary-700); font-size:17px; }
.auth-kicker { margin-bottom:10px; color:var(--primary-600); font-size:10px; font-weight:750; letter-spacing:.12em; }
.auth-main .auth-card #heading { margin:0; color:var(--neutral-900); text-align:left; font:500 clamp(37px, 4.25vw, 56px)/1.08 Georgia, 'Times New Roman', serif; letter-spacing:-2.1px; }
.auth-main .auth-card .auth-subtitle { max-width:430px; margin:12px 0 27px; color:var(--neutral-500); text-align:left; font-size:13px; line-height:1.65; }
.auth-main .auth-field { margin-bottom:15px; }
.auth-main .auth-field label { margin-bottom:7px; color:var(--neutral-700); font-size:12px; font-weight:650; }
.auth-main .auth-field input { min-height:52px; padding:13px 15px; border:1px solid var(--neutral-200); border-radius:12px; background:var(--neutral-0); color:var(--neutral-900); font-size:16px; }
.auth-main .auth-field input::placeholder { color:var(--neutral-400); opacity:.85; }
.auth-main .auth-field input:focus { border-color:var(--primary-400); box-shadow:0 0 0 3px var(--primary-50); }
.auth-main .auth-field-password input { padding-right:54px; }
.auth-main .auth-field-password #eye { position:absolute; right:7px; bottom:5px; display:grid; place-items:center; width:42px; height:42px; border:0; border-radius:9px; background:transparent; color:var(--neutral-400); font-size:15px; cursor:pointer; }
.auth-main .auth-field-password #eye:hover { background:var(--neutral-100); color:var(--primary-700); }
.auth-forgot-link { margin:-3px 0 13px; text-align:right; font-size:11px; }
.auth-forgot-link a { color:var(--primary-700); font-weight:650; }
.auth-forgot-link a:hover { text-decoration:underline; }
.auth-main #button-login, .auth-main #button-signup, .auth-main #button-verify, .auth-main #button-forgot { display:flex; align-items:center; justify-content:center; gap:12px; width:100%; min-height:52px; margin:8px 0 0; border-radius:12px; background:#315443; color:#fff; font-size:13px; font-weight:700; box-shadow:0 10px 22px rgba(49,84,67,.13); touch-action:manipulation; }
.auth-main #button-login:hover, .auth-main #button-signup:hover, .auth-main #button-verify:hover, .auth-main #button-forgot:hover { background:#29483c; box-shadow:0 12px 24px rgba(49,84,67,.19); }
.auth-main #button-login:disabled, .auth-main #button-signup:disabled, .auth-main #button-verify:disabled, .auth-main #button-forgot:disabled { opacity:.65; cursor:wait; }
.auth-main .auth-message { min-height:20px; margin:8px 0 0; text-align:left; font-size:12px; }
.auth-switch { margin-top:18px; color:var(--neutral-500); text-align:center; font-size:12px; }
.auth-switch a { color:var(--primary-700); font-weight:700; }
.auth-switch a:hover { text-decoration:underline; }
.auth-footer { display:flex; align-items:center; justify-content:center; gap:8px; margin-top:16px; color:var(--neutral-400); font-size:11px; }
.auth-footer i { color:var(--primary-500); font-size:10px; }
.auth-main .auth-verify-card #container-code-input { margin:18px 0 20px; }
.auth-main .auth-verify-card #button-verify { margin-top:10px; }
.auth-main .auth-verify-card .auth-subtitle { margin-bottom:19px; }
.auth-main .auth-verify-card .auth-message { text-align:center; }
.auth-layout :focus-visible { outline:3px solid var(--accent-400); outline-offset:3px; }
@media (max-width: 1000px) and (min-width: 841px) {
  .auth-layout { grid-template-columns:minmax(0, .88fr) minmax(0, 1.12fr); }
  .auth-story { padding-left:30px; padding-right:30px; }
  .auth-story h2 { font-size:clamp(40px, 5vw, 55px); letter-spacing:-2.8px; }
  .auth-note-card { max-width:360px; }
  .auth-main { padding-left:38px; padding-right:38px; }
}
@media (max-width: 840px) {
  .auth-layout { grid-template-columns:minmax(0, 1fr); }
  .auth-story { display:none; }
  .auth-layout { display:block; min-height:100vh; min-height:100svh; }
  .auth-main { min-height:100vh; min-height:100svh; padding:78px clamp(20px, 6vw, 32px) max(26px, env(safe-area-inset-bottom)); }
  .auth-mobile-brand { position:absolute; top:17px; left:clamp(20px, 6vw, 32px); display:inline-flex; align-items:center; gap:9px; color:var(--neutral-800); font-size:15px; font-weight:700; letter-spacing:-.3px; }
  .auth-mobile-brand-mark { width:32px; height:32px; display:grid; place-items:center; border-radius:10px; background:var(--primary-700); color:var(--neutral-0); font-size:14px; }
  .auth-back { top:13px; right:clamp(20px, 6vw, 32px); min-height:40px; font-size:11px; }
  .auth-main .auth-card { margin:auto; padding:10px 0 15px; }
  .auth-form-mark { width:43px; height:43px; margin-bottom:19px; border-radius:13px; }
  .auth-main .auth-card #heading { font-size:clamp(36px, 9vw, 48px); letter-spacing:-1.6px; }
  .auth-main .auth-card .auth-subtitle { margin-bottom:23px; }
  .auth-footer { margin:16px auto 0; }
}
@media (max-width: 380px) {
  .auth-main { padding:72px 20px max(22px, env(safe-area-inset-bottom)); }
  .auth-mobile-brand { top:14px; left:20px; font-size:14px; }
  .auth-back { top:10px; right:18px; gap:6px; font-size:10px; }
  .auth-main .auth-card #heading { font-size:clamp(33px, 9vw, 38px); }
  .auth-main .auth-field input { min-height:49px; }
  .auth-main .auth-card .auth-subtitle { margin-bottom:22px; }
}

/* Dark auth keeps the forest palette while giving the form its own readable surface. */
