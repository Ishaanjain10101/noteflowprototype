<style>
/* ===== Auth Pages (Login / Signup / Email Verify) ===== */
.auth-wrapper {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-50) 0%, var(--neutral-50) 50%, var(--accent-50) 100%);
  padding: 20px;
}

.auth-card {
  background: var(--neutral-0);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 48px 40px;
  width: 100%;
  max-width: 420px;
  position: relative;
}

.auth-logo {
  text-align: center;
  margin-bottom: 32px;
}

.auth-logo a {
  font-size: 24px;
  font-weight: 700;
  color: var(--primary-600);
  letter-spacing: -0.5px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.auth-logo a i {
  font-size: 28px;
}

#heading {
  font-size: 24px;
  font-weight: 700;
  color: var(--neutral-900);
  text-align: center;
  margin-bottom: 4px;
  letter-spacing: -0.5px;
}

.auth-subtitle {
  font-size: 14px;
  color: var(--neutral-400);
  text-align: center;
  margin-bottom: 32px;
}

.ball {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}

.ball i {
  font-size: 24px;
  color: var(--primary-600);
}

.auth-field {
  margin-bottom: 20px;
}

.auth-field label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--neutral-600);
  margin-bottom: 6px;
}

.auth-field input {
  width: 100%;
  padding: 12px 16px;
  border: 1.5px solid var(--neutral-200);
  border-radius: var(--radius-md);
  font-size: 14px;
  color: var(--neutral-800);
  background: var(--neutral-50);
  transition: all var(--transition-fast);
}

.auth-field input:focus {
  border-color: var(--primary-400);
  background: var(--neutral-0);
  box-shadow: 0 0 0 3px var(--primary-50);
}

.auth-field-password {
  position: relative;
}

.auth-field-password input {
  padding-right: 44px;
}

#eye {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--neutral-400);
  cursor: pointer;
  font-size: 16px;
  z-index: 3;
  transition: color var(--transition-fast);
}

#eye:hover {
  color: var(--neutral-600);
}

#button-login,
#button-signup,
#button-verify {
  width: 100%;
  padding: 12px;
  border-radius: var(--radius-md);
  background: var(--primary-600);
  color: var(--neutral-0);
  font-size: 15px;
  font-weight: 600;
  transition: all var(--transition-fast);
  margin-top: 8px;
}

#button-login:hover,
#button-signup:hover,
#button-verify:hover {
  background: var(--primary-700);
  box-shadow: var(--shadow-md);
}

#button-login:active,
#button-signup:active,
#button-verify:active {
  transform: scale(0.98);
}

#asking {
  text-align: center;
  margin-top: 24px;
  font-size: 14px;
  color: var(--neutral-400);
}

#asking a {
  color: var(--primary-600);
  font-weight: 600;
  transition: color var(--transition-fast);
}

#asking a:hover {
  color: var(--primary-700);
}

/* ===== Email Verify Code Input ===== */
#container-code-input {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin: 20px 0 28px;
}

.code-input {
  width: 48px;
  height: 56px;
  text-align: center;
  font-size: 20px;
  font-weight: 700;
  color: var(--neutral-900);
  border: 1.5px solid var(--neutral-200);
  border-radius: var(--radius-md);
  background: var(--neutral-50);
  transition: all var(--transition-fast);
}

.code-input:focus {
  border-color: var(--primary-400);
  background: var(--neutral-0);
  box-shadow: 0 0 0 3px var(--primary-50);
}

.code-input:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

#lastinput {
  position: relative;
}

/* ===== Email Verify Dialog ===== */
#exhausted {
  border: none;
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-lg);
  font-size: 15px;
  font-weight: 500;
  color: var(--error-500);
}

#exhausted::backdrop {
  background: rgba(0,0,0,0.3);
}

/* ===== Not Logged In Nav ===== */
nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 40px;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--neutral-200);
}

nav .nav-logo {
  font-size: 22px;
  font-weight: 700;
  color: var(--primary-600);
  display: flex;
  align-items: center;
  gap: 8px;
}

nav .nav-logo i {
  font-size: 26px;
}

#container-log {
  display: flex;
  gap: 12px;
}

#container-log .but {
  display: block;
}

#container-log #login {
  padding: 8px 24px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  color: var(--neutral-700);
  transition: all var(--transition-fast);
}

#container-log #login:hover {
  background: var(--neutral-100);
}

#container-log #getstarted {
  padding: 8px 24px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  background: var(--primary-600);
  color: var(--neutral-0);
  transition: all var(--transition-fast);
}

#container-log #getstarted:hover {
  background: var(--primary-700);
  box-shadow: var(--shadow-sm);
}

/* ===== Hero (not logged in index) ===== */
.hero {
  min-height: calc(100vh - 72px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40px 20px;
  margin-top: 72px;
}

.hero h1 {
  font-size: 48px;
  font-weight: 800;
  color: var(--neutral-900);
  letter-spacing: -1px;
  line-height: 1.15;
  max-width: 640px;
  margin-bottom: 16px;
}

.hero h1 .highlight {
  color: var(--primary-600);
}

.hero p {
  font-size: 18px;
  color: var(--neutral-500);
  max-width: 480px;
  margin-bottom: 32px;
  line-height: 1.6;
}

.hero .cta-row {
  display: flex;
  gap: 16px;
}

.hero .cta-primary {
  padding: 14px 32px;
  border-radius: var(--radius-md);
  background: var(--primary-600);
  color: var(--neutral-0);
  font-size: 15px;
  font-weight: 600;
  transition: all var(--transition-fast);
}

.hero .cta-primary:hover {
  background: var(--primary-700);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.hero .cta-secondary {
  padding: 14px 32px;
  border-radius: var(--radius-md);
  border: 1.5px solid var(--neutral-200);
  color: var(--neutral-700);
  font-size: 15px;
  font-weight: 600;
  transition: all var(--transition-fast);
}

.hero .cta-secondary:hover {
  border-color: var(--primary-300);
  color: var(--primary-600);
}

.hero .features {
  display: flex;
  gap: 48px;
  margin-top: 64px;
  flex-wrap: wrap;
  justify-content: center;
}

.hero .feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  max-width: 160px;
}

.hero .feature .feature-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: var(--primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero .feature .feature-icon i {
  font-size: 22px;
  color: var(--primary-600);
}

.hero .feature .feature-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--neutral-700);
}

.hero .feature .feature-text {
  font-size: 12px;
  color: var(--neutral-400);
  text-align: center;
}

/* ===== Profile / Settings Pages ===== */
.profile-wrapper,
.settings-wrapper {
  max-width: 640px;
  margin: 0 auto;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 40px;
}

.profile-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background: var(--primary-500);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  font-weight: 700;
  color: var(--neutral-0);
  flex-shrink: 0;
}

.profile-info h2 {
  font-size: 24px;
  font-weight: 700;
  color: var(--neutral-900);
  margin-bottom: 4px;
}

.profile-info p {
  font-size: 14px;
  color: var(--neutral-400);
}

.profile-stats {
  display: flex;
  gap: 24px;
  margin-bottom: 40px;
}

.profile-stat {
  flex: 1;
  background: var(--neutral-0);
  border: 1px solid var(--neutral-200);
  border-radius: var(--radius-lg);
  padding: 20px;
  text-align: center;
}

.profile-stat .stat-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--primary-600);
}

.profile-stat .stat-label {
  font-size: 12px;
  color: var(--neutral-400);
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.settings-section {
  background: var(--neutral-0);
  border: 1px solid var(--neutral-200);
  border-radius: var(--radius-lg);
  padding: 24px;
  margin-bottom: 24px;
}

.settings-section h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--neutral-900);
  margin-bottom: 16px;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid var(--neutral-100);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-row .setting-label {
  font-size: 14px;
  color: var(--neutral-700);
}

.settings-row .setting-value {
  font-size: 14px;
  color: var(--neutral-400);
}

.toggle-switch {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  background: var(--neutral-300);
  position: relative;
  cursor: pointer;
  transition: background var(--transition-fast);
}

.toggle-switch::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--neutral-0);
  box-shadow: var(--shadow-xs);
  transition: transform var(--transition-fast);
}

.toggle-switch.active {
  background: var(--primary-500);
}

.toggle-switch.active::after {
  transform: translateX(20px);
}

.danger-btn {
  padding: 10px 20px;
  border-radius: var(--radius-sm);
  background: var(--error-100);
  color: var(--error-500);
  font-size: 14px;
  font-weight: 600;
  transition: all var(--transition-fast);
}

.danger-btn:hover {
  background: var(--error-500);
  color: var(--neutral-0);
}

@media (max-width: 768px) {
  .auth-card {
    padding: 32px 24px;
  }
  nav {
    padding: 16px 20px;
  }
  .hero h1 {
    font-size: 32px;
  }
  .hero p {
    font-size: 16px;
  }
  .profile-header {
    flex-direction: column;
    text-align: center;
  }
  .profile-stats {
    flex-direction: column;
  }
}
</style>
