<div id="container-maincontent">
    <div id="header">
        <div id="heading">
            <%-title%>
        </div>
        <div id="sub-heading">
            All the notes will get permanently get deleted in 30 days
        </div>
        <div id="underline"></div>
    </div>
    <div id="option-selection-grid-list">
        <button id="grid-button" data-select="true">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 50px;">
                    <rect x="3" y="3" width="8" height="8" rx="2"/>
                    <rect x="13" y="3" width="8" height="8" rx="2"/>
                    <rect x="3" y="13" width="8" height="8" rx="2"/>
                    <rect x="13" y="13" width="8" height="8" rx="2"/>
                </svg>
            </div>
        </button>
        <button id="list-button" data-select="false">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 50px;">
                    <rect x="3" y="4" width="4" height="4" rx="1"/>
                    <line x1="11" y1="6" x2="21" y2="6"/>
                    <rect x="3" y="10" width="4" height="4" rx="1"/>
                    <line x1="11" y1="12" x2="21" y2="12"/>
                    <rect x="3" y="16" width="4" height="4" rx="1"/>
                    <line x1="11" y1="18" x2="21" y2="18"/>
                </svg>
            </div>
        </button>
    </div>
    <div style="width: 100%; height:100px;"></div>
    <div id="form" style="position: relative; margin-top: 50px;" data-form="grid">
        <%if(notes.length === 0){%>
            <img src="/images/noNotes2.png" alt="No notes" style="height:67vh;position: absolute;right: 400px;">
        <%}%>
        <%notes.forEach((note,i)=>{%>
            <div class="Note" id="note-<%=i+1%>" data-form="grid" >
                <div class="title-note" id="title-note-<%=i+1%>"></div> 
                <div class="content-note" id="content-note-<%=i+1%>"></div>
                <div id="last-deleted">
                    Days left:
                </div>
                <div id="updatedAt-note">
                    <% const deletionDate = new Date(note.updatedAt)%>
                    <% const now = Date.now()%>
                    <%=30 - new Date(now - deletionDate).getDate()%>
                </div>  
                <a href="/note/trash/<%=note._id%>">
                    <div id="view-more">
                        View More
                    </div>
                </a>
                <div class="dustbin dustbin-icon" data-id="<%=note._id%>" id="trash-<%=note._id%>" title="Delete Forever">
                    <i class="fa-solid fa-trash-can" ></i>
                </div>
                <div class="recover recover-icon" data-id="<%=note._id%>" id="recover-<%=note._id%>" title="Recover">
                    <i class="fa-solid fa-arrow-rotate-left"></i>
                </div>
            </div>
            <dialog id="<%-note._id%>" class="confirmdialog">
                <div>Are you sure you want to delete this note PERMANENTLY?</div>
                <button id="yes">Yes</button>
                <button id="no">No</button>
            </dialog>
            
        <%})%>
    </div>
</div>
<script>
    const notesObject = <%- JSON.stringify(notes) %>;
</script>