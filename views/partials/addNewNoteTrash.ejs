<button id="logout">Sign Out</button>

<div id="container-maincontent">
    <div id="header">
        <div id="heading"><%-title%></div>
        <div id="sub-heading">Notes will be permanently deleted after 30 days</div>
        <div id="underline"></div>
    </div>

    <div id="option-selection-grid-list"<%= notes.length === 0 ? ' class="empty-view-controls"' : "" %>>
        <button id="grid-button" data-select="true" aria-label="Grid view" title="Grid view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="8" height="8" rx="2"/>
                <rect x="13" y="3" width="8" height="8" rx="2"/>
                <rect x="3" y="13" width="8" height="8" rx="2"/>
                <rect x="13" y="13" width="8" height="8" rx="2"/>
            </svg>
        </button>
        <button id="list-button" data-select="false" aria-label="Row view" title="Row view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="4" height="4" rx="1"/>
                <line x1="11" y1="6" x2="21" y2="6"/>
                <rect x="3" y="10" width="4" height="4" rx="1"/>
                <line x1="11" y1="12" x2="21" y2="12"/>
                <rect x="3" y="16" width="4" height="4" rx="1"/>
                <line x1="11" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
    </div>

    <div id="form" data-form="grid" class="<%= notes.length === 0 ? 'empty-form' : '' %>">
        <%if(notes.length === 0){%>
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid fa-trash-can"></i></div>
                <div class="empty-title">Trash is empty</div>
                <div class="empty-text">Deleted notes will appear here for 30 days.</div>
            </div>
        <%}%>

        <%notes.forEach((note,i)=>{%>
            <div class="Note" id="note-<%=i+1%>" data-form="grid">
                <div class="title-note" id="title-note-<%=i+1%>"></div>
                <div class="content-note" id="content-note-<%=i+1%>"></div>
                <div id="last-deleted">Days left:</div>
                <div id="updatedAt-note">
                    <% const deletionDate = new Date(note.updatedAt) %>
                    <% const now = Date.now() %>
                    <%=30 - new Date(now - deletionDate).getDate()%>
                </div>
                <div class="trash-card-actions">
                    <a class="note-view-more" href="/note/trash/<%=note._id%>">View More</a>
                    <div class="trash-actions">
                        <button type="button" class="recover trash-action-button recover-icon" data-id="<%=note._id%>" id="recover-<%=note._id%>" title="Recover note">
                            <i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>
                            <span>Recover</span>
                        </button>
                        <button type="button" class="dustbin trash-action-button dustbin-icon" data-id="<%=note._id%>" id="trash-<%=note._id%>" title="Delete forever">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                            <span>Delete</span>
                        </button>
                    </div>
                </div>
            </div>
            <dialog id="<%-note._id%>" class="confirmdialog">
                <div>Are you sure you want to delete this note PERMANENTLY?</div>
                <button id="yes">Yes</button>
                <button id="no">No</button>
            </dialog>
        <%})%>
    </div>
</div>

<script>
    const notesObject = <%- JSON.stringify(notes) %>;
    const initialView = window.innerWidth > 950 && localStorage.getItem("viewStyle") === "Row" ? "list" : "grid";
    const notesForm = document.getElementById("form");
    const gridButton = document.getElementById("grid-button");
    const listButton = document.getElementById("list-button");
    notesForm.setAttribute("data-form", initialView);
    gridButton.setAttribute("data-select", initialView === "grid" ? "true" : "false");
    listButton.setAttribute("data-select", initialView === "list" ? "true" : "false");
    document.querySelectorAll(".Note").forEach((note) => note.setAttribute("data-form", initialView));
</script>