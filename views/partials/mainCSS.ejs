<style>
/* ===== Sidebar ===== */
.container-sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 240px;
  height: 100vh;
  background: var(--neutral-0);
  border-right: 1px solid var(--neutral-200);
  display: flex;
  flex-direction: column;
  padding: 24px 0;
  z-index: 100;
  transition: transform var(--transition-base);
}

.container-sidebar .logo {
  padding: 0 24px;
  margin-bottom: 32px;
  font-size: 22px;
  font-weight: 700;
  color: var(--primary-600);
  letter-spacing: -0.5px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.container-sidebar .logo span {
  color: var(--neutral-800);
}

.container-sidebar .option {
  display: block;
  padding: 0 24px;
  margin-bottom: 2px;
}

.container-sidebar .option > div {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  border-radius: var(--radius-md);
  color: var(--neutral-600);
  font-size: 14px;
  font-weight: 500;
  transition: all var(--transition-fast);
}

.container-sidebar .option > div i {
  width: 20px;
  text-align: center;
  font-size: 16px;
}

.container-sidebar .option > div:hover {
  background: var(--neutral-100);
  color: var(--neutral-900);
}

.container-sidebar .option > div.active {
  background: var(--primary-50);
  color: var(--primary-600);
  font-weight: 600;
}

.container-sidebar .sidebar-footer {
  margin-top: auto;
  padding: 16px 24px;
  border-top: 1px solid var(--neutral-200);
}

.container-sidebar .sidebar-footer .tagline {
  font-size: 12px;
  color: var(--neutral-400);
  line-height: 1.6;
}

/* ===== Main Content ===== */
#container-maincontent {
  margin-left: 240px;
  min-height: 100vh;
  padding: 32px 40px;
  transition: margin var(--transition-base);
}

#header {
  margin-bottom: 24px;
}

#heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--neutral-900);
  letter-spacing: -0.5px;
}

#sub-heading {
  font-size: 14px;
  color: var(--neutral-400);
  margin-top: 4px;
}

#underline {
  width: 48px;
  height: 3px;
  background: var(--primary-500);
  border-radius: 2px;
  margin-top: 12px;
display:none;
}

/* ===== Grid/List Toggle ===== */
#option-selection-grid-list {
  display: flex;
  gap: 8px;
  margin-bottom: 24px;
}

#option-selection-grid-list button {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--neutral-200);
  background: var(--neutral-0);
  color: var(--neutral-400);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}

#option-selection-grid-list button svg {
  width: 18px;
  height: 18px;
}

#option-selection-grid-list button:hover {
  border-color: var(--primary-300);
  color: var(--primary-500);
}

#option-selection-grid-list button[data-select="true"] {
  background: var(--primary-500);
  border-color: var(--primary-500);
  color: var(--neutral-0);
}

/* ===== Note Cards ===== */
#form {
  display: grid;
  gap: 16px;
}

#form[data-form="grid"] {
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
}

#form[data-form="list"] {
  grid-template-columns: 1fr;
}

#form.empty-form {
  grid-template-columns: minmax(0, 1fr);
  min-height: 360px;
}

#form.empty-form .empty-state {
  grid-column: 1 / -1;
  width: 100%;
  min-height: 360px;
}

#option-selection-grid-list.empty-view-controls {
  justify-content: center;
}

.Note {
  background: var(--neutral-0);
  border: 1px solid var(--neutral-200);
  border-radius: var(--radius-lg);
  padding: 20px;
  position: relative;
  transition: all var(--transition-base);
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 140px;
}

.Note:hover {
  border-color: var(--primary-200);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.Note[data-form="list"] {
  flex-direction: row;
  align-items: center;
  gap: 24px;
  min-height: auto;
  padding: 16px 20px;
}

.title-note {
  font-size: 16px;
  font-weight: 600;
  color: var(--neutral-900);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.Note[data-form="list"] .title-note {
  min-width: 200px;
  flex-shrink: 0;
}

.content-note {
  font-size: 13px;
  color: var(--neutral-500);
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.Note[data-form="list"] .content-note {
  -webkit-line-clamp: 1;
  flex: 1;
}

#createdAt-note {
  font-size: 11px;
  color: var(--neutral-400);
  margin-top: auto;
}

.Note[data-form="list"] #createdAt-note {
  margin-top: 0;
  flex-shrink: 0;
  min-width: 100px;
  text-align: right;
}

#updatedAt-note {
  font-size: 11px;
  color: var(--neutral-400);
}

#last-deleted {
  font-size: 11px;
  color: var(--warning-500);
  font-weight: 600;
}

#view-more {
  display: inline-flex;
  align-items: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--primary-600);
  transition: color var(--transition-fast);
  margin-top: 4px;
}

#view-more:hover {
  color: var(--primary-700);
}

.note-view-more {
  display: inline-flex;
  align-items: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--primary-600);
  transition: color var(--transition-fast);
  white-space: nowrap;
}

.note-view-more:hover {
  color: var(--primary-700);
}

.note-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  width: 100%;
  margin-top: auto;
  padding-top: 4px;
}

.Note[data-form="list"] #view-more {
  flex-shrink: 0;
}

.Note[data-form="list"] .note-actions {
  width: auto;
  margin-top: 0;
  margin-left: auto;
  padding-top: 0;
  flex-shrink: 0;
}

/* ===== Star, Pin, Delete Icons ===== */
.star {
  position: absolute;
  top: 16px;
  right: 16px;
  cursor: pointer;
}

.star svg {
  width: 20px;
  height: 20px;
  transition: all var(--transition-fast);
}

.star svg:hover {
  transform: scale(1.15);
}

.pin-div {
  position: absolute;
  top: 16px;
  right: 48px;
  cursor: pointer;
}

.pin-div svg {
  width: 20px;
  height: 20px;
  transition: all var(--transition-fast);
}

.pin-div svg:hover {
  transform: scale(1.15);
}

.Note[data-form="list"] .star,
.Note[data-form="list"] .pin-div {
  position: relative;
  top: auto;
  right: auto;
  flex-shrink: 0;
}

.Note[data-form="list"] .dustbin {
  position: relative;
  flex-shrink: 0;
}

.dustbin {
  cursor: pointer;
  color: var(--neutral-400);
  transition: color var(--transition-fast);
  display: flex;
  align-items: center;
  font-size: 14px;
}

.dustbin:hover {
  color: var(--error-500);
}

.recover {
  cursor: pointer;
  color: var(--neutral-400);
  transition: color var(--transition-fast);
  display: flex;
  align-items: center;
  font-size: 14px;
}

.recover:hover {
  color: var(--success-500);
}

.trash-card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  margin-top: auto;
  padding-top: 8px;
}

.trash-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.trash-action-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}

.trash-action-button.recover-icon {
  color: var(--primary-600);
  background: var(--primary-50);
}

.trash-action-button.recover-icon:hover {
  background: var(--primary-100);
  border-color: var(--primary-200);
}

.trash-action-button.dustbin-icon {
  color: var(--error-500);
  background: var(--error-100);
}

.trash-action-button.dustbin-icon:hover {
  color: var(--neutral-0);
  background: var(--error-500);
}

.Note[data-form="list"] .trash-card-actions {
  width: auto;
  margin-top: 0;
  margin-left: auto;
  padding-top: 0;
  flex-shrink: 0;
}

/* ===== Confirm Dialog ===== */
:root[data-theme="dark"] .confirmdialog {
  background: var(--neutral-0);
  color: var(--neutral-800);
}
.confirmdialog {
  position: fixed;
  inset: 0;
  margin: auto;
  width: min(400px, calc(100vw - 32px));
  max-height: calc(100vh - 32px);
  overflow-y: auto;
  border: none;
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-lg);
  max-width: 400px;
  text-align: center;
}

.confirmdialog::backdrop {
  background: rgba(0,0,0,0.3);
}

.confirmdialog > div:first-child {
  font-size: 15px;
  font-weight: 500;
  color: var(--neutral-800);
  margin-bottom: 20px;
}

.confirmdialog #yes,
.confirmdialog #no {
  padding: 8px 24px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  transition: all var(--transition-fast);
}

.confirmdialog #yes {
  color: var(--error-500);
  background: var(--error-100);
}

.confirmdialog #yes:hover {
  background: var(--error-500);
  color:#fff;
  border: 1px solid var(--warning-500);
}

.confirmdialog #no {
  background: var(--neutral-100);
  color: var(--neutral-600);
  margin-left: 8px;
}

.confirmdialog #no:hover {
  background: var(--neutral-200);
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  text-align: center;
}

.empty-state .empty-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.empty-state .empty-icon i {
  font-size: 32px;
  color: var(--primary-300);
}

.empty-state .empty-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--neutral-700);
  margin-bottom: 4px;
}

.empty-state .empty-text {
  font-size: 14px;
  color: var(--neutral-400);
}

/* Row view is hidden and disabled on narrower screens. */
@media (max-width: 950px) {
  #list-button { display: none; }
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
  .container-sidebar {
    width: 64px;
    padding: 16px 0;
  }
  .container-sidebar .logo {
    width: 100%;
    padding: 0;
    justify-content: center;
    text-align: center;
    font-size: 0;
  }
  .container-sidebar .logo i {
    display: block;
    margin: 0 auto;
    font-size: 24px;
  }
  .container-sidebar .option > div div:not(:first-child) {
    display: none;
  }
  .container-sidebar .option > div {
    justify-content: center;
    padding: 12px;
  }
  .container-sidebar .sidebar-footer {
    display: none;
  }
  #container-maincontent {
    margin-left: 64px;
    padding: 20px;
  }
  #form[data-form="grid"] {
    grid-template-columns: 1fr;
  }
  .Note[data-form="list"] {
    flex-direction: column;
    align-items: flex-start;
  }
  .Note[data-form="list"] .title-note {
    min-width: auto;
  }
  .Note[data-form="list"] .note-actions {
    width: 100%;
    margin-left: 0;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .Note[data-form="list"] .trash-card-actions {
    width: 100%;
    margin-left: 0;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .trash-actions {
    flex-wrap: wrap;
  }
}


/* ===== NoteFlow visual refresh ===== */
:root:not([data-theme="dark"]) {
  --primary-50: #edf1e9; --primary-100: #dce5d5; --primary-200: #c1d0b7;
  --primary-300: #9daf91; --primary-400: #819476; --primary-500: #6c8062;
  --primary-600: #586d50; --primary-700: #46583f; --primary-800: #364632; --primary-900: #293629;
  --accent-50: #fbf0e9; --accent-100: #f4dfd0; --accent-200: #ebc2a7; --accent-300: #dda17c;
  --accent-400: #ca805a; --accent-500: #b96846;
  --neutral-50: #f7f6f1; --neutral-100: #f0eee7; --neutral-200: #e4e1d8; --neutral-300: #d1cdc2;
  --neutral-400: #96958a; --neutral-500: #74746c; --neutral-600: #5b5d55; --neutral-700: #42463f;
  --neutral-800: #2c322c; --neutral-900: #202720; --neutral-950: #151b16;
  --radius-sm: 8px; --radius-md: 12px; --radius-lg: 18px; --radius-xl: 26px;
  --shadow-xs: 0 1px 2px rgba(53,58,45,.04); --shadow-sm: 0 4px 14px rgba(53,58,45,.06);
  --shadow-md: 0 12px 30px rgba(53,58,45,.09); --shadow-lg: 0 24px 70px rgba(53,58,45,.14);
}
:root[data-theme="dark"] {
  --primary-50: #283127; --primary-100: #354332; --primary-200: #4d6148; --primary-300: #6e875f;
  --primary-400: #8da47d; --primary-500: #a8bb99; --primary-600: #bfd0b3; --primary-700: #d1dec8;
  --accent-50: #38271f; --accent-100: #503629; --accent-200: #81513a; --accent-300: #bd805d; --accent-400: #d79b79; --accent-500: #e2ad8e;
  --neutral-50: #171a17; --neutral-100: #20241f; --neutral-200: #30362f; --neutral-300: #454c44;
  --neutral-400: #969e91; --neutral-500: #b0b7aa; --neutral-600: #c4cabe; --neutral-700: #d7dcd2;
  --neutral-800: #e8ebe4; --neutral-900: #f2f3ee; --neutral-950: #fbfcf8;
}
body { background: var(--neutral-50); }
:focus-visible { outline: 3px solid var(--primary-400); outline-offset: 3px; }
.container-sidebar { width: 252px; padding: 27px 0 18px; background: var(--neutral-50); border-right-color: var(--neutral-200); }
.container-sidebar .logo { padding: 0 27px; margin-bottom: 42px; gap: 11px; font-size: 21px; letter-spacing: -.7px; }
.container-sidebar .logo i { width: 34px; height: 34px; display: grid; place-items: center; color: var(--neutral-0); background: var(--primary-600); border-radius: 11px; font-size: 16px; }
.container-sidebar .option { padding: 0 15px; margin: 2px 0; }
.container-sidebar .option > div { gap: 13px; min-height: 45px; padding: 10px 14px; border-radius: 11px; font-size: 13px; }
.container-sidebar .option > div.active { background: var(--primary-100); color: var(--primary-700); }
.container-sidebar .option > div i { font-size: 15px; }
.container-sidebar .sidebar-footer { margin: auto 21px 0; padding: 16px 6px 0; }
.container-sidebar .sidebar-footer .tagline { font-size: 11px; }
#container-maincontent { margin-left: 252px; max-width: 1600px; padding: 43px clamp(26px, 4.5vw, 72px); }
#header { margin: 0 0 25px; }
#heading { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(30px, 3vw, 39px); font-weight: 500; letter-spacing: -1.1px; color: var(--neutral-900); }
#sub-heading { margin-top: 7px; font-size: 14px; color: var(--neutral-500); }
#option-selection-grid-list { margin-bottom: 22px; }
#option-selection-grid-list button { width: 40px; height: 40px; border-radius: 11px; background: var(--neutral-50); }
#option-selection-grid-list button[data-select="true"] { background: var(--primary-600); border-color: var(--primary-600); color: #fff; }
#form[data-form="grid"] { grid-template-columns: repeat(auto-fill, minmax(min(100%, 285px), 1fr)); gap: 18px; }
.Note { min-height: 198px; padding: 22px 22px 18px; border: 1px solid var(--neutral-200); border-radius: 16px; background: var(--neutral-0); box-shadow: var(--shadow-xs); gap: 10px; }
.Note:hover { border-color: var(--primary-200); box-shadow: var(--shadow-md); transform: translateY(-3px); }
#form[data-form="grid"] .Note:nth-of-type(3n + 1) { background:#f0f3eb; }
#form[data-form="grid"] .Note:nth-of-type(3n + 2) { background:#fbf0e9; }
#form[data-form="grid"] .Note:nth-of-type(3n) { background:#f1eff5; }
:root[data-theme="dark"] #form[data-form="grid"] .Note:nth-of-type(3n + 1) { background:#242c23; }
:root[data-theme="dark"] #form[data-form="grid"] .Note:nth-of-type(3n + 2) { background:#30251f; }
:root[data-theme="dark"] #form[data-form="grid"] .Note:nth-of-type(3n) { background:#28262e; }

.title-note { padding-right: 48px; font-family: Georgia, 'Times New Roman', serif; font-size: 19px; font-weight: 500; letter-spacing: -.25px; line-height: 1.35; }
.content-note { font-size: 13px; line-height: 1.7; color: var(--neutral-600); -webkit-line-clamp: 4; }
#createdAt-note { padding-top: 10px; font-size: 11px; letter-spacing: .02em; color: var(--neutral-400); }
.Note[data-form="list"] { min-height: 84px; padding: 15px 20px; gap: 20px; }
.Note[data-form="list"] .title-note { font-family: var(--font-heading); font-size: 15px; font-weight: 600; }
.note-view-more { min-height: 38px; padding: 0 13px; border-radius: 9px; background: var(--primary-50); color: var(--primary-700); font-size: 12px; }
.note-view-more:hover { background: var(--primary-100); }
.star, .pin-div { width: 30px; height: 30px; display: grid; place-items: center; top: 16px; right: 16px; border-radius: 8px; }
.pin-div { right: 51px; }
.star:hover, .pin-div:hover { background: var(--neutral-100); }
.star svg, .pin-div svg { width: 18px; height: 18px; }
.dustbin { width: 32px; height: 32px; justify-content: center; border-radius: 8px; }
.dustbin:hover { background: var(--error-100); }
.empty-state { max-width: 480px; margin: auto; padding: 70px 22px; }
.empty-state .empty-icon { border-radius: 22px; background: var(--primary-100); }
.empty-state .empty-title { font-family: Georgia, 'Times New Roman', serif; font-size: 23px; font-weight: 500; }
.confirmdialog { background: var(--neutral-0); }
.confirmdialog #no { color: var(--neutral-700); }

/* Align the trash actions as a matched pair; legacy icon sizing should not
   constrain the labeled permanent-delete action. */
.trash-card-actions .trash-actions { align-items:center; gap:9px; }
.trash-card-actions .trash-action-button {
  width:auto;
  min-width:92px;
  min-height:38px;
  height:auto;
  padding:0 12px;
  border:1px solid transparent;
  border-radius:10px;
  line-height:1;
}
.trash-card-actions .trash-action-button i { flex:0 0 auto; }
.trash-card-actions .dustbin-icon {
  color:var(--error-500);
  background:var(--error-100);
}
.trash-card-actions .dustbin-icon:hover {
  border-color:var(--error-500);
  background:var(--error-500);
  color:#fff;
}
.trash-card-actions .recover-icon { border-color:var(--primary-100); }
.trash-card-actions .recover-icon:hover { border-color:var(--primary-200); }
.trash-card-actions .trash-action-button:focus-visible {
  outline:3px solid var(--primary-400);
  outline-offset:2px;
}
@media (max-width:560px) {
  .trash-card-actions .trash-actions { gap:8px; }
  .trash-card-actions .trash-action-button { min-width:88px; min-height:40px; padding:0 10px; }
}

/* A real product preview anchors the landing page's editorial layout. */
.landing-shell { max-width: 1420px; margin: 0 auto; padding: 70px clamp(24px, 6vw, 92px) 42px; }
.hero { display: grid; grid-template-columns: minmax(330px, .82fr) minmax(480px, 1.18fr); align-items: center; gap: clamp(40px, 7vw, 112px); max-width: 1280px; margin: 10px auto 0; padding: 26px 0 74px; }
.hero-copy { max-width: 540px; }
.hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; color: var(--primary-700); font-size: 10px; font-weight: 700; letter-spacing: .16em; }
.hero-eyebrow span { width: 22px; height: 1px; background: var(--accent-500); }
.hero h1 { max-width: 600px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(48px, 5.4vw, 76px); line-height: 1.02; font-weight: 400; letter-spacing: -3.8px; color: var(--neutral-900); }
.hero h1 .highlight { color: var(--primary-600); font-style: italic; }
.hero-copy > p { max-width: 440px; margin: 23px 0 29px; font-size: 16px; line-height: 1.8; color: var(--neutral-600); }
.cta-row { display: flex; align-items: center; flex-wrap: wrap; gap: 21px; }
.cta-primary { display: inline-flex; align-items: center; justify-content: center; gap: 15px; min-height: 49px; padding: 0 20px; border-radius: 10px; background: var(--primary-700); color: #fff; font-size: 13px; font-weight: 600; box-shadow: 0 8px 20px rgba(70,88,63,.16); transition: transform var(--transition-fast), background var(--transition-fast); }
