<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<link rel="stylesheet" href="/stylesheets/main.css">
<link rel="stylesheet" href="/stylesheets/editor.css">
</head>
<body>
    <%- include("partials/loggedin") %>
    <div class="editor-wrapper">
        <div id="container-note" data-id="<%=noteId%>">
            <div id="name">View Note</div>
            <input type="text" id="title" value="<%=title%>">
            <textarea name="content" id="content"><%=content%></textarea>
            <div class="editor-actions">
                <button class="outside-element" id="edit"><i class="fa-regular fa-pen-to-square"></i> Edit</button>
                <button class="outside-element" id="update"><i class="fa-regular fa-floppy-disk"></i> Update</button>
            </div>
        </div>
    </div>
    <dialog id="incomplete-data">Please fill in both the title and the content</dialog>
    <script src="/scripts/viewMore.js"></script>
</body>
</html>
