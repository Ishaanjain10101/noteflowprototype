<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/mainCSS") %>
</head>
<body>
    <%- !signedIn ? include("partials/notLoggedin") : include("partials/loggedin") %>

    <% if (!signedIn) { %>
        <div class="hero">
            <h1>Capture ideas.<br><span class="highlight">Organise thoughts.</span><br>Flow effortlessly.</h1>
            <p>NoteFlow is a clean, simple notes app that helps you write, organise, and find your notes with ease.</p>
            <div class="cta-row">
                <a href="/signup" class="cta-primary">Get Started Free</a>
                <a href="/login" class="cta-secondary">Login</a>
            </div>
            <div class="features">
                <div class="feature">
                    <div class="feature-icon"><i class="fa-solid fa-bolt"></i></div>
                    <div class="feature-title">Quick Notes</div>
                    <div class="feature-text">Jot down ideas in seconds</div>
                </div>
                <div class="feature">
                    <div class="feature-icon"><i class="fa-solid fa-star"></i></div>
                    <div class="feature-title">Favourites</div>
                    <div class="feature-text">Star important notes</div>
                </div>
                <div class="feature">
                    <div class="feature-icon"><i class="fa-solid fa-thumbtack"></i></div>
                    <div class="feature-title">Pinned</div>
                    <div class="feature-text">Keep key notes on top</div>
                </div>
                <div class="feature">
                    <div class="feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="feature-title">Secure</div>
                    <div class="feature-text">Your notes are private</div>
                </div>
            </div>
        </div>
    <% } else { %>
        <%- include("partials/addNewNoteNotTrash") %>
    <% } %>

    <script src="/scripts/indexLoggedIn.js"></script>
</body>
</html>
