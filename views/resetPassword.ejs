<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/authCSS") %>
</head>
<body>
<main class="recovery-page">
    <header class="recovery-topbar">
        <a class="recovery-brand" href="/" aria-label="NoteFlow home"><span class="recovery-brand-mark"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i></span> NoteFlow</a>
        <span class="recovery-secure"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Secure reset</span>
    </header>
    <div class="recovery-content">
        <nav class="recovery-progress" aria-label="Password reset steps">
            <span class="recovery-step is-complete"><i class="fa-solid fa-check" aria-hidden="true"></i><span>Email</span></span>
            <span class="recovery-step-line is-complete"></span>
            <span class="recovery-step is-complete"><i class="fa-solid fa-check" aria-hidden="true"></i><span>Verify</span></span>
            <span class="recovery-step-line is-complete"></span>
            <span class="recovery-step is-current"><i class="fa-solid fa-key" aria-hidden="true"></i><span>New password</span></span>
        </nav>
        <section class="recovery-card recovery-password-card" aria-labelledby="heading">
            <div class="recovery-art recovery-art-password" aria-hidden="true">
                <span class="recovery-art-orbit recovery-art-orbit-one"></span><span class="recovery-art-orbit recovery-art-orbit-two"></span>
                <span class="recovery-art-icon"><i class="fa-solid fa-lock"></i></span>
                <span class="recovery-art-spark recovery-art-spark-one">✦</span><span class="recovery-art-spark recovery-art-spark-two">✧</span>
            </div>
            <div class="recovery-copy">
                <div class="recovery-kicker">STEP 3 · MAKE IT YOURS AGAIN</div>
                <h1 id="heading">Choose a fresh password.</h1>
                <p class="recovery-subtitle">Use at least 8 characters. A phrase you’ll remember works well.</p>
                <form id="reset-form">
                    <div class="recovery-field">
                        <label for="password-input">New password</label>
                        <input id="password-input" name="password" type="password" autocomplete="new-password" minlength="8" placeholder="At least 8 characters" required>
                    </div>
                    <div class="recovery-field">
                        <label for="confirm-password-input">Confirm new password</label>
                        <input id="confirm-password-input" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Type it once more" required>
                    </div>
                    <p class="recovery-password-hint"><i class="fa-regular fa-circle-check" aria-hidden="true"></i> At least 8 characters</p>
                    <button id="button-reset" class="recovery-submit" type="submit"><span>Save new password</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    <p id="reset-message" class="recovery-message" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>
        <footer class="recovery-footer"><i class="fa-solid fa-lock" aria-hidden="true"></i> Your password is protected with secure hashing.</footer>
    </div>
</main>
<script>
  const form = document.getElementById("reset-form");
  const password = document.getElementById("password-input");
  const confirmPassword = document.getElementById("confirm-password-input");
  const button = document.getElementById("button-reset");
  const message = document.getElementById("reset-message");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    message.className = "recovery-message";
    if (!password.value.trim()) {
      message.textContent = "Your password can’t be only spaces.";
      message.classList.add("is-error"); password.focus(); return;
    }
    if (password.value.length < 8) {
      message.textContent = "Use at least 8 characters for your new password.";
      message.classList.add("is-error"); password.focus(); return;
    }
    if (password.value !== confirmPassword.value) {
      message.textContent = "The passwords don’t match yet.";
      message.classList.add("is-error"); confirmPassword.focus(); return;
    }
    button.disabled = true;
    message.textContent = "Saving your new password…";
    try {
      const response = await fetch("/reset-password", {
        method:"POST", headers:{"Content-Type":"application/json"},
        body:JSON.stringify({password:password.value, confirmPassword:confirmPassword.value})
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || "Couldn’t update the password. Please try again.");
      form.hidden = true;
      message.textContent = `${data.message || "Password updated."} Taking you to sign in…`;
      message.classList.add(data.emailSent ? "is-success" : "is-error");
      setTimeout(() => window.location.assign("/login?passwordReset=1"), 1800);
    } catch (error) {
      message.textContent = error.message || "Couldn’t connect. Check your connection and try again.";
      message.classList.add("is-error"); button.disabled = false;
    }
  });
</script>
</body>
</html>
