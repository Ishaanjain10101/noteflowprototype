<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<link rel="stylesheet" href="/stylesheets/auth.css">
</head>
<body>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <a href="/"><i class="fa-solid fa-feather-pointed"></i> NoteFlow</a>
        </div>
        <div id="heading">Create Account</div>
        <div class="auth-subtitle">Start capturing your ideas today</div>
        <div>
            <div class="auth-field">
                <label for="name-input">Username</label>
                <input type="text" id="name-input">
            </div>
            <div class="auth-field">
                <label for="email-input">Email</label>
                <input type="email" id="email-input" autocomplete="username" required>
            </div>
            <div class="auth-field auth-field-password">
                <label for="password-input">Password</label>
                <input type="password" id="password-input" autocomplete="new-password" required>
                <i class="fa-solid fa-eye-slash" id="eye"></i>
            </div>
        </div>
        <button id="button-signup">Sign Up</button>
        <div id="asking">Already have an account? <a href="/login">Login</a></div>
    </div>
</div>
<script src="/scripts/signup.js"></script>
</body>
</html>
