<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/mainCSS") %>
<%- include("partials/editorCSS") %>
</head>
<body>
    <%- include("partials/loggedin") %>
    <div class="editor-wrapper">
        <div class="editor-page-heading">
            <div id="name">Add Note</div>
            <a class="editor-back" href="/"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to notes</a>
        </div>
        <div class="draft-tools" style="display: none;">
            <p class="draft-status" id="draft-status" role="status" aria-live="polite" hidden style="display: none;"></p>
            <button type="button" class="editor-draft-clear" id="discard-draft" hidden style="display: none;">Discard draft</button>
        </div>
        <input type="text" id="title" placeholder="Title">
        <textarea name="content" id="content" placeholder="Start writing..."></textarea>
        <div class="editor-actions">
            <button class="outside-element" id="save"><i class="fa-regular fa-floppy-disk"></i> Save</button>
            <svg class="outside-element" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" id="star" fill="none" stroke="var(--neutral-700)" stroke-width="1.5" stroke-linejoin="round">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
        </div>
    </div>
    <dialog id="incomplete-data"><strong>Note is incomplete</strong><p>Please add a title and some content before saving.</p></dialog>
    <script src="/scripts/add.js"></script>
</body>
</html>
