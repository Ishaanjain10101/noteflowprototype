<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/authCSS") %>
</head>
<body>
<main class="recovery-page">
    <header class="recovery-topbar">
        <a class="recovery-brand" href="/" aria-label="NoteFlow home"><span class="recovery-brand-mark"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i></span> NoteFlow</a>
        <a class="recovery-home" href="/forgot-password"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Change email</a>
    </header>
    <div class="recovery-content">
        <nav class="recovery-progress" aria-label="Password reset steps">
            <span class="recovery-step is-complete"><i class="fa-solid fa-check" aria-hidden="true"></i><span>Email</span></span>
            <span class="recovery-step-line is-complete"></span>
            <span class="recovery-step is-current"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Verify</span></span>
            <span class="recovery-step-line"></span>
            <span class="recovery-step"><i class="fa-solid fa-key" aria-hidden="true"></i><span>New password</span></span>
        </nav>
        <section class="recovery-card recovery-code-card" aria-labelledby="heading">
            <div class="recovery-art recovery-art-mail" aria-hidden="true">
                <span class="recovery-art-orbit recovery-art-orbit-one"></span><span class="recovery-art-orbit recovery-art-orbit-two"></span>
                <span class="recovery-art-icon"><i class="fa-solid fa-envelope-open-text"></i></span>
                <span class="recovery-art-spark recovery-art-spark-one">✦</span><span class="recovery-art-spark recovery-art-spark-two">✧</span>
            </div>
            <div class="recovery-copy">
                <div class="recovery-kicker">STEP 2 · VERIFY IT’S YOU</div>
                <h1 id="heading">A little code, then you’re in.</h1>
                <p class="recovery-subtitle">Enter the six digits we sent to <strong><%= emailHint %></strong>. The code is good for 10 minutes.</p>
                <div id="container-code-input" class="recovery-code-inputs" role="group" aria-label="Six-digit verification code">
                    <input type="text" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" class="code-input" aria-label="Verification code">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 2">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 3">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 4">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 5">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 6">
                </div>
                <button id="button-verify" class="recovery-submit" type="button"><span>Verify and continue</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                <p id="verify-message" class="recovery-message" role="status" aria-live="polite"></p>
                <div class="recovery-resend">Didn’t get the email? <button id="resend-code" type="button">Send a new code</button></div>
            </div>
        </section>
        <footer class="recovery-footer"><i class="fa-solid fa-lock" aria-hidden="true"></i> Your notes stay yours. We’ll never ask you to share this code.</footer>
    </div>
</main>
<script src="/scripts/forgot-password-verify.js"></script>
</body>
</html>
