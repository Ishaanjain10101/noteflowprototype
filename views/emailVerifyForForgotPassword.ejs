<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/authCSS") %>
</head>
<body>
<div class="auth-layout">
    <%- include("partials/authStory") %>
    <main class="auth-main">
        <%- include("partials/authMobileBrand") %>
        <a class="auth-back" href="/"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to home</a>
        <section class="auth-card auth-verify-card" aria-labelledby="heading">
            <div class="auth-form-mark"><i class="fa-solid fa-envelope-circle-check" aria-hidden="true"></i></div>
            <div class="auth-kicker">ACCOUNT SECURITY</div>
            <h1 id="heading">Check your inbox.</h1>
            <p class="auth-subtitle">Enter the six-digit code we sent to verify your password reset request.</p>
            <div id="container-code-input" role="group" aria-label="Six-digit verification code">
                <input type="text" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" class="code-input" aria-label="Verification code">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 2">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 3">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 4">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 5">
                <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="code-input" aria-label="Verification digit 6">
            </div>
            <button id="button-verify" type="button">Verify code <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
            <p id="verify-message" class="auth-message" role="status" aria-live="polite"></p>
        </section>
        <div class="auth-footer"><i class="fa-solid fa-lock" aria-hidden="true"></i> Your notes stay yours.</div>
    </main>
</div>
<dialog id="exhausted">You have used all verification attempts.</dialog>
<script src="/scripts/forgot-password-verify.js"></script>
</body>
</html>
