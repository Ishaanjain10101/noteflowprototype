<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/authCSS") %>
</head>
<body>
<main class="recovery-page">
    <header class="recovery-topbar">
        <a class="recovery-brand" href="/" aria-label="NoteFlow home"><span class="recovery-brand-mark"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i></span> NoteFlow</a>
        <a class="recovery-home" href="/settings"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to settings</a>
    </header>
    <div class="recovery-content">
        <section class="recovery-card" aria-labelledby="heading">
            <div class="recovery-art recovery-art-password" aria-hidden="true">
                <span class="recovery-art-orbit recovery-art-orbit-one"></span><span class="recovery-art-orbit recovery-art-orbit-two"></span>
                <span class="recovery-art-icon"><i class="fa-solid fa-shield-halved"></i></span>
                <span class="recovery-art-spark recovery-art-spark-one">✦</span><span class="recovery-art-spark recovery-art-spark-two">✧</span>
            </div>
            <div class="recovery-copy">
                <div class="recovery-kicker">ACCOUNT SECURITY · SIGNED IN</div>
                <h1 id="heading">A fresh key for your notes.</h1>
                <p class="recovery-subtitle">Confirm your current password, then choose and confirm a new one.</p>
                <form id="change-password-form" novalidate>
                    <div class="recovery-field">
                        <label for="current-password">Current password</label>
                        <input id="current-password" name="currentPassword" type="password" autocomplete="current-password" placeholder="Enter your current password" required>
                    </div>
                    <div class="recovery-field">
                        <label for="new-password">New password</label>
                        <input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="8" placeholder="At least 8 characters" required>
                    </div>
                    <div class="recovery-field">
                        <label for="confirm-password">Confirm new password</label>
                        <input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Type your new password again" required>
                    </div>
                    <p class="recovery-password-hint"><i class="fa-regular fa-circle-check" aria-hidden="true"></i> Use at least 8 characters.</p>
                    <button id="change-password-submit" class="recovery-submit" type="submit"><span>Update password</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    <p id="change-password-status" class="recovery-message" role="status" aria-live="polite"></p>
                </form>
                <a class="recovery-return" href="/forgot-password"><i class="fa-solid fa-life-ring" aria-hidden="true"></i> Forgot your current password?</a>
            </div>
        </section>
        <footer class="recovery-footer"><i class="fa-solid fa-lock" aria-hidden="true"></i> We’ll email you when your password changes.</footer>
    </div>
</main>
<script>
    const form = document.getElementById("change-password-form");
    const currentPassword = document.getElementById("current-password");
    const newPassword = document.getElementById("new-password");
    const confirmPassword = document.getElementById("confirm-password");
    const submitButton = document.getElementById("change-password-submit");
    const status = document.getElementById("change-password-status");

    form.addEventListener("submit", async (event) => {
        event.preventDefault();
        status.className = "recovery-message";
        status.textContent = "";
        if (!currentPassword.value || !newPassword.value || !confirmPassword.value) {
            status.textContent = "Fill in all three password fields.";
            status.classList.add("is-error");
            (!currentPassword.value ? currentPassword : !newPassword.value ? newPassword : confirmPassword).focus();
            return;
        }
        if (!newPassword.value.trim()) {
            status.textContent = "Your password can’t be only spaces.";
            status.classList.add("is-error");
            newPassword.focus();
            return;
        }
        if (newPassword.value.length < 8) {
            status.textContent = "Use at least 8 characters for your new password.";
            status.classList.add("is-error");
            newPassword.focus();
            return;
        }
        if (newPassword.value !== confirmPassword.value) {
            status.textContent = "The new passwords don’t match yet.";
            status.classList.add("is-error");
            confirmPassword.focus();
            return;
        }

        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Updating password…';
        status.textContent = "Checking your current password…";
        try {
            const response = await fetch("/change-password", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    currentPassword: currentPassword.value,
                    newPassword: newPassword.value,
                    confirmPassword: confirmPassword.value
                })
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.message || "Couldn’t update your password. Please try again.");
            form.reset();
            status.textContent = result.message;
            status.classList.add(result.emailSent ? "is-success" : "is-error");
        } catch (error) {
            status.textContent = error.message || "Couldn’t connect. Please try again.";
            status.classList.add("is-error");
        } finally {
            submitButton.disabled = false;
            submitButton.innerHTML = '<span>Update password</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i>';
        }
    });
</script>
</body>
</html>
