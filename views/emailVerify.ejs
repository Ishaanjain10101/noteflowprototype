<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<link rel="stylesheet" href="/stylesheets/auth.css">
</head>
<body>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <a href="/"><i class="fa-solid fa-feather-pointed"></i> NoteFlow</a>
        </div>
        <div class="ball"><i class="fa-solid fa-envelope-circle-check" id="lock"></i></div>
        <div id="heading">Verify Your Email</div>
        <div class="auth-subtitle">A verification code has been sent to your email</div>
        <div id="container-code-input">
            <input type="text" maxlength="1" class="code-input">
            <input type="text" maxlength="1" class="code-input">
            <input type="text" maxlength="1" class="code-input">
            <input type="text" maxlength="1" class="code-input">
            <input type="text" maxlength="1" class="code-input">
            <input type="text" maxlength="1" class="code-input" id="lastinput">
        </div>
        <button id="button-verify">Verify</button>
    </div>
</div>
<dialog id="exhausted">You have exhausted all your verification attempts</dialog>
<script src="/scripts/verify.js"></script>
</body>
</html>
