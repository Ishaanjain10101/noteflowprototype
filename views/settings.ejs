<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/mainCSS") %>
<%- include("partials/authCSS") %>
</head>
<body>
    <%- include("partials/loggedin") %>
    <div id="container-maincontent">
        <div id="header">
            <div id="heading">Settings</div>
            <div id="underline"></div>
        </div>
        <div class="settings-wrapper">
            <div class="settings-section">
                <h3>Preferences</h3>
                <div class="settings-row">
                    <div class="setting-label">Default view</div>
                    <div class="setting-value">
                        <select name="toggle-view" id="toggle-view" aria-label="Default view">
                            <option value="Grid">Grid</option>
                            <option value="Row">Row</option>
                        </select>
                    </div>
                </div>
                <div class="settings-row">
                    <div class="setting-label">Theme</div>
                    <div class="setting-value">
                        <select name="toggle-theme" id="toggle-theme" aria-label="Theme">
                            <option value="Light">Light</option>
                            <option value="Dark">Dark</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="settings-section">
                <h3>Change password</h3>
                <p class="settings-card-copy">Update your password using your current password.</p>
                <a class="settings-action-link" href="/change-password">Change password <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <section class="settings-section export-section" aria-labelledby="export-notes-heading">
                <h3 id="export-notes-heading">Export notes</h3>
                <p class="settings-card-copy">Download a copy of your active notes. ZIP includes TXT, PDF, and JSON files.</p>
                <form class="export-form" action="/settings/export" method="get">
                    <label for="export-format">File format</label>
                    <div class="export-controls">
                        <select id="export-format" name="format" aria-label="Export file format">
                            <option value="txt">Plain text (.txt)</option>
                            <option value="pdf">PDF document (.pdf)</option>
                            <option value="json">JSON data (.json)</option>
                            <option value="zip">ZIP bundle (.zip)</option>
                        </select>
                        <button type="submit" class="export-button"><i class="fa-solid fa-download" aria-hidden="true"></i> Download export</button>
                    </div>
                    <p class="export-note">Trashed notes are excluded from the export.</p>
                </form>
            </section>
            <div class="settings-section">
                <h3>Log out</h3>
                <p class="settings-card-copy">End your current NoteFlow session on this device.</p>
                <div class="settings-row">
                    <button type="button" class="danger-btn" id="settings-logout">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Log out
                    </button>
                </div>
                <p class="settings-feedback" id="logout-status" role="status" aria-live="polite" hidden></p>
            </div>
            <div class="settings-section account-danger-section">
                <h3>Delete account</h3>
                <p class="account-danger-copy">Permanently remove your account and its notes. This action cannot be undone.</p>
                <button type="button" class="danger-btn" id="delete-account">
                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i> Delete account
                </button>
                <p class="account-danger-status" id="delete-account-status" role="status" aria-live="polite" hidden></p>
            </div>
        </div>
    </div>
    <dialog class="settings-confirm-dialog" id="logout-confirm-dialog" aria-labelledby="logout-dialog-title" aria-describedby="logout-dialog-copy">
        <div class="settings-dialog-icon"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i></div>
        <h2 id="logout-dialog-title">Log out of NoteFlow?</h2>
        <p id="logout-dialog-copy">You’ll need to log in again to get back to your notes.</p>
        <div class="settings-dialog-actions">
            <button type="button" class="settings-dialog-button secondary" data-close-dialog="logout-confirm-dialog" autofocus>Stay here</button>
            <button type="button" class="settings-dialog-button primary" id="confirm-logout">Log out</button>
        </div>
    </dialog>
    <dialog class="settings-confirm-dialog is-destructive" id="delete-confirm-dialog" aria-labelledby="delete-dialog-title" aria-describedby="delete-dialog-copy">
        <div class="settings-dialog-icon"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></div>
        <h2 id="delete-dialog-title">Delete your account?</h2>
        <p id="delete-dialog-copy">This permanently deletes your account and all your notes. You can’t undo this action.</p>
        <div class="settings-dialog-actions">
            <button type="button" class="settings-dialog-button secondary" data-close-dialog="delete-confirm-dialog" autofocus>Keep my account</button>
            <button type="button" class="settings-dialog-button danger" id="confirm-delete-account">Delete account</button>
        </div>
    </dialog>
    <script>
        const viewSelect = document.getElementById("toggle-view");
        const themeSelect = document.getElementById("toggle-theme");
        const savedView = localStorage.getItem("viewStyle");
        const savedTheme = localStorage.getItem("themeStyle") || localStorage.getItem("themeStype");

        viewSelect.value = savedView === "Row" ? "Row" : "Grid";
        const explicitTheme = savedTheme === "Dark" || savedTheme === "Light";
        const systemTheme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "Dark" : "Light";
        themeSelect.value = explicitTheme ? savedTheme : systemTheme;

        function applyTheme(theme) {
            const normalizedTheme = theme === "Dark" ? "Dark" : "Light";
            document.documentElement.dataset.theme = normalizedTheme.toLowerCase();
            localStorage.setItem("themeStyle", normalizedTheme);
            localStorage.removeItem("themeStype");
        }

        applyTheme(themeSelect.value);
        viewSelect.addEventListener("change", () => {
            localStorage.setItem("viewStyle", viewSelect.value === "Row" ? "Row" : "Grid");
        });
        themeSelect.addEventListener("change", () => applyTheme(themeSelect.value));

        const logoutDialog = document.getElementById("logout-confirm-dialog");
        const deleteDialog = document.getElementById("delete-confirm-dialog");
        const logoutTrigger = document.getElementById("settings-logout");
        const deleteTrigger = document.getElementById("delete-account");

        document.querySelectorAll("[data-close-dialog]").forEach((button) => {
            button.addEventListener("click", () => document.getElementById(button.dataset.closeDialog).close());
        });

        logoutTrigger.addEventListener("click", () => {
            const status = document.getElementById("logout-status");
            status.hidden = true;
            status.textContent = "";
            logoutDialog.showModal();
        });

        document.getElementById("confirm-logout").addEventListener("click", async (event) => {
            const button = event.currentTarget;
            logoutDialog.close();
            button.disabled = true;
            logoutTrigger.disabled = true;
            button.innerHTML = '<i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Logging out…';
            try {
                const response = await fetch("/logout", { method: "POST" });
                if (response.ok) {
                    window.location.href = "/";
                    return;
                }
                throw new Error("Unable to log out. Please try again.");
            } catch (error) {
                const status = document.getElementById("logout-status");
                status.textContent = error.message || "Unable to log out. Please try again.";
                status.hidden = false;
            }
            button.disabled = false;
            logoutTrigger.disabled = false;
            button.innerHTML = "Log out";
            logoutTrigger.focus();
        });

        deleteTrigger.addEventListener("click", () => {
            const status = document.getElementById("delete-account-status");
            status.hidden = true;
            status.classList.remove("error");
            status.textContent = "";
            deleteDialog.showModal();
        });

        document.getElementById("confirm-delete-account").addEventListener("click", async (event) => {
            const button = event.currentTarget;
            const status = document.getElementById("delete-account-status");
            deleteDialog.close();
            button.disabled = true;
            deleteTrigger.disabled = true;
            try {
                status.hidden = false;
                status.textContent = "Deleting your account…";
                const response = await fetch("/account", { method: "DELETE" });
                if (!response.ok) throw new Error("Could not delete your account. Please try again.");
                localStorage.removeItem("data-form");
                localStorage.removeItem("noteflow:add-note-draft:v1");
                localStorage.removeItem("themeStype");
                localStorage.removeItem("viewStyle");
                window.location.href = "/";
            } catch (error) {
                status.hidden = false;
                status.classList.add("error");
                status.textContent = error.message || "Could not delete the account. Please try again.";
                deleteTrigger.disabled = false;
                button.disabled = false;
                deleteTrigger.focus();
            }
        });
    </script>
</body>
</html>
