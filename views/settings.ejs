<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>
<%- include("partials/mainCSS") %>
<%- include("partials/authCSS") %>
</head>
<body>
    <%- include("partials/loggedin") %>
    <div id="container-maincontent">
        <div id="header">
            <div id="heading">Settings</div>
            <div id="underline"></div>
        </div>

        <div class="settings-wrapper">
            <div class="settings-section">
                <h3>Preferences</h3>
                <div class="settings-row">
                    <div class="setting-label">Default view</div>
                    <div class="setting-value">
                        <select name="toggle-view" id="toggle-view">
                            <option value="Grid" selected>Grid</option>
                            <option value="Row">Row</option>
                        </select>
                    </div>
                </div>
                <div class="settings-row">
                    <div class="setting-label">Theme</div>
                    <div class="setting-value">
                        <select name="toggle-theme" id="toggle-theme">
                            <option value="Dark" selected>Dark</option>
                            <option value="Light">Light</option>
                        </select>
                    </div>
                </div>
               
            </div>



            <div class="settings-section">
                <h3>Notifications</h3>
                <div class="settings-row">
                    <div class="setting-label">Email notifications</div>
                    <div class="toggle-switch"></div>
                </div>
                <div class="settings-row">
                    <div class="setting-label">Trash cleanup reminders</div>
                    <div class="toggle-switch active"></div>
                </div>
            </div>

            <div class="settings-section">
                <h3>Account</h3>
                <div class="settings-row">
                    <div class="setting-label">Change password</div>
                    <div id="view-more">Change</div>
                </div>
                <div class="settings-row">
                    <div class="setting-label">Profile</div>
                    <a href="/profile"><div id="view-more">View Profile</div></a>
                </div>
                <div class="settings-row">
                    <div class="setting-label">Sign out</div>
                    <button class="danger-btn" id="logout">Sign Out</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        const viewSelect = document.getElementById("toggle-view");

        viewSelect.addEventListener("change", () => {
            const selectedView = viewSelect.value;

            localStorage.setItem("viewStyle",selectedView);

        });

        const themeSelect = document.getElementById("toggle-theme");

        themeSelect.addEventListener("change", () => {
            const selectedTheme = themeSelect.value;

            localStorage.setItem("themeStype",selectedTheme);

        });
    </script>
</body>
</html>
